{
  "name": "hathras-potato-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Hathras Potato Logistics & Cold Storage Optimization Dashboard",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "node --test shared/engine/*.test.js"
  },
  "dependencies": {
    "express": "4.21.2",
    "leaflet": "1.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "recharts": "2.15.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "concurrently": "9.1.0",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "vite": "5.4.11"
  },
  "engines": {
    "node": ">=18.18"
  }
}
